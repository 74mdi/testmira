---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../utils/dates';

const { Content } = await Astro.props.render();
const { title, description, pubDate, updatedDate, tags } = Astro.props.frontmatter;
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={pubDate}>{formatDate(pubDate)}</time>
        {updatedDate && (<span class="updated">Updated: {formatDate(updatedDate)}</span>)}
      </div>
      {tags && tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (<span class="tag">{tag}</span>))}
        </div>
      )}
    </header>

    <div class="post-content">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/blog" class="back-link">← Back to blog</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header { margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }

  h1 { font-size: 2.5rem; font-weight: 700; line-height: 1.2; letter-spacing: -0.03em; margin-bottom: 1rem; color: var(--text); }

  .post-meta { display: flex; gap: 1.5rem; color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1rem; }
  .updated { font-style: italic; }

  .post-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tag { background: var(--bg-secondary); color: var(--accent); padding: 0.25rem 0.75rem; border-radius: 4px; font-size: 0.85rem; border: 1px solid var(--border); }

  .post-content { font-size: 1.05rem; line-height: 1.8; }
  .post-content :global(h2) { font-size: 1.75rem; margin-top: 3rem; margin-bottom: 1rem; font-weight: 600; letter-spacing: -0.02em; }
  .post-content :global(h3) { font-size: 1.35rem; margin-top: 2rem; margin-bottom: 0.75rem; font-weight: 600; }
  .post-content :global(p) { margin-bottom: 1.25rem; }

  .post-footer { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border); }
  .back-link { color: var(--text-secondary); text-decoration: none; font-size: 0.95rem; transition: color 0.2s; }
  .back-link:hover { color: var(--accent); }
</style>
