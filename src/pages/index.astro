---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/dates';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout>
  <section class="hero">
    <h1>testmira</h1>
    <p class="hero-subtitle">A minimal dark blog. Thoughts, notes, and experiments.</p>
  </section>

  <section class="recent-posts">
    <h2>Recent Posts</h2>
    {posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}`} class="post-link">
              <span class="post-title">{post.data.title}</span>
              <time datetime={post.data.pubDate}>{formatDate(post.data.pubDate)}</time>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="no-posts">No posts yet. Check back soon.</p>
    )}
    <a href="/blog" class="view-all">View all posts →</a>
  </section>
</BaseLayout>

<style>
  .hero { text-align: center; padding: 4rem 0; margin-bottom: 3rem; }
  .hero h1 {
    font-size: 3rem; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--text) 0%, var(--accent) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .hero-subtitle { font-size: 1.2rem; color: var(--text-secondary); max-width: 500px; margin: 0 auto; }

  .recent-posts { margin-bottom: 4rem; }
  .recent-posts h2 { font-size: 1.5rem; font-weight: 600; margin-bottom: 1.5rem; letter-spacing: -0.02em; }

  .post-list { list-style: none; padding: 0; margin: 0; }
  .post-link { display: flex; justify-content: space-between; align-items: baseline; padding: 1rem 0; border-bottom: 1px solid var(--border); text-decoration: none; transition: all 0.2s; }
  .post-link:hover { padding-left: 0.5rem; border-bottom-color: var(--accent); }
  .post-title { color: var(--text); font-weight: 500; font-size: 1.05rem; }
  .post-link:hover .post-title { color: var(--accent); }
  time { color: var(--text-secondary); font-size: 0.9rem; white-space: nowrap; margin-left: 1rem; }

  .no-posts { color: var(--text-secondary); text-align: center; padding: 2rem 0; }
  .view-all { display: inline-block; margin-top: 1.5rem; color: var(--accent); text-decoration: none; font-weight: 500; }
  .view-all:hover { text-decoration: underline; }
</style>
